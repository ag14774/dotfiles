# Template. Copy to ~/.config/zsh/secrets.zsh and fill in real values.
# That path is gitignored and sourced by the ~/.zshrc managed block.
# NEVER commit the real file.
#
# export AZURE_OPENAI_PASSWORD="..."
# export TAVILY_API_KEY="..."
#
# Only if opencode uses Google Vertex as its provider: point it at your GCP
# project (and optionally region) so gcai/opencode can authenticate. Leave unset
# to just use whatever non-Google model opencode is configured with.
# export GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# export VERTEX_LOCATION="global"
