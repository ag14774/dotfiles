root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kdl,py}]
indent_size = 4

# As shfmt -i 2 -ci (config/ has an .editorconfig of its own).
[*.sh]
switch_case_indent = true

[*.md]
trim_trailing_whitespace = false

[*.lua]
indent_style = tab

[**/git/config]
indent_style = tab
