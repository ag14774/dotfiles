# completions.zsh -- extra CLI completions, sourced by the ~/.zshrc dotfiles
# block AFTER shell/init.zsh so compinit has run (these use compdef).

# Prefer V2's generated completions; retain the V1 fallback during migration.
if command -v opencode >/dev/null 2>&1; then
  _dotfiles_opencode_completion=$(command opencode --completions zsh 2>/dev/null)
  if [[ $? == 0 && -n $_dotfiles_opencode_completion ]]; then
    eval "$_dotfiles_opencode_completion"
    unset _dotfiles_opencode_completion
    return
  fi
  unset _dotfiles_opencode_completion
fi

# V1 opencode CLI completion (generated by `opencode completion`).
###-begin-opencode-completions-###
#
# yargs command completion script
#
# Installation: opencode completion >> ~/.zshrc
#    or opencode completion >> ~/.zprofile on OSX.
#
_opencode_yargs_completions() {
  local reply
  local si=$IFS
  IFS=$'
' reply=($(COMP_CWORD="$((CURRENT - 1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" opencode --get-yargs-completions "${words[@]}"))
  IFS=$si
  if [[ ${#reply} -gt 0 ]]; then
    _describe 'values' reply
  else
    _default
  fi
}
if [[ "'${zsh_eval_context[-1]}" == "loadautofunc" ]]; then
  _opencode_yargs_completions "$@"
else
  compdef _opencode_yargs_completions opencode
fi
###-end-opencode-completions-###
