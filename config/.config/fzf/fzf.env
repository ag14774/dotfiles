# fzf file-list env -- sourced by the dotfiles .zshrc block AND by
# ~/.config/zellij/yazi-picker.sh, so Yazi's `z` behaves the same whether fzf is
# launched from an interactive shell or from the Alt-y picker (whose bash runs
# with the zellij *session* env, which can predate these vars). The actual fzf
# options (prompt + Alt-g gitignore toggle) live in fzf.conf.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzf.conf"
