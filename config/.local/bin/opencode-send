#!/usr/bin/env bash
# opencode-send -- give the OpenCode pane of the current Zellij tab a code
# reference, and the selected text, then focus it.
#
#   opencode-send FILE [START [END [LANGUAGE]]] [< SELECTION]
#   opencode-send --text < TEXT
#
# It pastes (as the terminal would, so nothing is submitted) "FILE:START-END "
# and, when SELECTION is more than one character, the selection as a fenced
# code block: OpenCode shows that as "[Pasted ~N lines]" and sends its text,
# including edits you haven't saved. You then type your question. FILE is shown
# relative to the OpenCode pane's directory when it is inside it. With --text,
# it pastes TEXT as it is (the Alt-v review's comments).
#
# Not tied to an editor: Helix binds it to `+a` (helix/config.toml), sending its
# primary selection on stdin.
set -u

RESOLVE="$HOME/.config/zellij/pane-id.sh"

# Act on this pane's session by name: given a session name that no longer
# exists, plain `zellij action` acts on whichever session is running.
zj() { zellij --session "$ZELLIJ_SESSION_NAME" action "$@"; }
die() {
  printf 'opencode-send: %s\n' "$1" >&2
  exit 1
}

usage() {
  printf 'usage: opencode-send FILE [START [END [LANGUAGE]]] [< SELECTION]\n       opencode-send --text < TEXT\n' >&2
  exit 2
}
text=""
if [ "${1:-}" = --text ]; then
  [ "$#" -eq 1 ] || usage
  text=1 file="" start="" end="" language=""
else
  [ "$#" -ge 1 ] && [ "$#" -le 4 ] || usage
  file=$1 start=${2:-} end=${3:-} language=${4:-}
fi
[ -n "${ZELLIJ:-}" ] && [ -n "${ZELLIJ_SESSION_NAME:-}" ] && [ -n "${ZELLIJ_PANE_ID:-}" ] ||
  die "not inside Zellij"
selection=""
[ -t 0 ] || selection=$(cat)
[ -z "$text" ] || [ -n "$selection" ] || die "no text to send on stdin"

panes=$(zj list-panes --json 2>/dev/null) || die "could not list the Zellij panes"
tab=$(jq -r --arg me "$ZELLIJ_PANE_ID" '[.[] | select(.is_plugin == false and (.id | tostring) == $me)][0].tab_id // empty' <<<"$panes")
[ -n "$tab" ] || die "pane $ZELLIJ_PANE_ID (ZELLIJ_PANE_ID) does not exist"
target=$(bash "$RESOLVE" opencode "$tab")
[ -n "$target" ] || die "this tab has no OpenCode pane"
target_cwd=$(jq -r --arg id "${target#terminal_}" '.[] | select(.is_plugin == false and (.id | tostring) == $id) | .pane_cwd // empty' <<<"$panes")

reference=""
if [ -z "$text" ] && [ "$file" != "[scratch]" ]; then
  case "$file" in
    /*) path=$file ;;
    *) path=$PWD/$file ;;
  esac
  if [ -n "$target_cwd" ]; then
    case "$path" in "$target_cwd"/*) path=${path#"$target_cwd"/} ;; esac
  fi
  reference=$path
  if [ -n "$start" ]; then
    reference="$reference:$start"
    [ -z "$end" ] || [ "$end" = "$start" ] || reference="$reference-$end"
  fi
fi

paste() { zj write-chars --pane-id "$target" $'\e[200~'"$1"$'\e[201~' || die "could not paste into the OpenCode pane"; }
[ -z "$reference" ] || paste "$reference "
if [ -n "$text" ]; then
  paste "$selection"
elif [ "${#selection}" -gt 1 ]; then
  fence='```'
  case "$selection" in *'```'*) fence='````' ;; esac
  paste "$fence$language"$'\n'"$selection"$'\n'"$fence"
  paste " "
fi
zj focus-pane-id "$target" || die "could not focus the OpenCode pane"
