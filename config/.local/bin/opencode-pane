#!/usr/bin/env bash
# opencode-pane -- run OpenCode in a Zellij pane that survives a restart.
#
#   opencode-pane [--session ID] [--prompt PROMPT]
#                                     start OpenCode (a new conversation, or
#                                     conversation ID), sending PROMPT if given
#   opencode-pane --resume            continue this folder's most recent
#                                     conversation, if it has one
#
# When Zellij restores the pane after a restart, it continues the folder's most
# recent conversation; a prompt is never sent twice. OpenCode gets your shell's
# environment (~/.zshrc's PATH and secrets).
#
# How: Zellij restores a pane with the command line it started with, so a
# fresh start reruns this script as `--resume`, passing "fresh" (and the
# conversation and prompt) in the environment for that run only. OpenCode runs
# in an interactive zsh without job control (+m), which keeps it in this
# pane's process group, so Zellij records this script, not `opencode`.
set -u

usage() {
  printf 'usage: opencode-pane [--session ID] [--prompt PROMPT] | --resume\n' >&2
  exit 2
}
if [ "${1:-}" = --resume ]; then
  [ "$#" -eq 1 ] || usage
else
  session="" prompt=""
  [ "${1-x}" != "" ] || shift # an empty first argument means no options
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session)
        [ "$#" -ge 2 ] && [ -n "$2" ] || usage
        session=$2
        ;;
      --prompt)
        [ "$#" -ge 2 ] || usage
        prompt=$2
        ;;
      *) usage ;;
    esac
    shift 2
  done
  OPENCODE_PANE_FRESH=1 OPENCODE_PANE_SESSION=$session OPENCODE_PANE_PROMPT=$prompt exec "$0" --resume
fi

fresh=${OPENCODE_PANE_FRESH:-}
session=${OPENCODE_PANE_SESSION:-}
prompt=${OPENCODE_PANE_PROMPT:-}
unset OPENCODE_PANE_FRESH OPENCODE_PANE_SESSION OPENCODE_PANE_PROMPT

# shellcheck disable=SC2016 # expanded by zsh, not here
code='
fresh=$1 session=$2 prompt=$3
args=()
[[ -n $session ]] && args+=(--session "$session")
[[ -n $prompt ]] && args+=(--prompt "$prompt")
if [[ -z $fresh ]]; then
  dir=$(jq -rn --arg d "$PWD" "\$d | @uri")
  opencode api get "/api/session?limit=1&order=desc&parentID=null&directory=$dir" 2>/dev/null \
    | jq -e ".data | length > 0" >/dev/null 2>&1 && args=(--continue)
fi
opencode "${args[@]}"'
zsh -i +m -c "$code" opencode-pane "$fresh" "$session" "$prompt"
exit $?
